#!/usr/bin/env -iS /usr/bin/bash --noprofile --norc
# 
# Operation Integrity
#
# Secure path variable
declare -rx PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin
#
# Make directory to store logs
log_dir="/var/log/hiaudit"
mkdir -p "$log_dir"


#
# Helper Functions, Wrappers & Variables
#
# Regex to compare against to verify user input is a number
numberCheck='^[0-9]+$'
#
# Wrap the exit command to print the summary before exiting the script if the exit command is ran with code 0 or ran with no exit code
exit() {
	if [[ -z "$@" || "$@" == 0 ]]; then
		cat <<-EOF
			Script Succeeded
			File checks:
			    $log_dir/immutable-files
			    $log_dir/append-only-files
			    $log_dir/media-files
			    $log_dir/suspect-scripts
			Possibly compromised binaries and risky file permissions
			    $log_dir/clamscan-audit
			    $log_dir/integrity-fails
			    $log_dir/chkrootkit-audit
			    $log_dir/world-writable-files
			    $log_dir/world-readable-files
			    $log_dir/suid-binaries
			    $log_dir/sgid-binaries
			Possible backdoors and general vulns
			    $log_dir/possible-pam-hooks
			    $log_dir/lynis-audit
			    $log_dir/wordpress-vulns
			    $log_dir/open-ports
			Session log of script(s)
			    $log_dir/*-script-master-log
			Note that all log names shown are incomplete and have a suffix to prevent loss of previous log files on subsequent runs, you'll need to check ($log_dir) for the full file names.
			Not all log files will exist until all scripts have been ran
		EOF
		command exit 0
	else
		command exit $@
	fi
}
#
# Print 25 newlines opposed to clearing to allow for scrolling
clear() {
	printf '\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n'
}
#
# When making a file using the touch command, make the directories its supposed to be in.
touch() {
	local options=()
	local files=()
	#
	# Separate options from file paths
	for arg in "$@"; do
		if [[ "$arg" =~ ^-* ]]; then
			options+=("$arg")
		else
			files+=("$arg")
		fi
	done
	#
	# Process each file path
	for file in "${files[@]}"; do
		local dir
		dir=$(dirname "$file")
		#
		# Create the directory if it's not the current directory
		if [[ "$dir" != "." ]]; then
			mkdir -p "$dir"
		fi
	done
	#
	# Pass everything back to the original touch command
	command touch "${options[@]}" "${files[@]}"
}
#
# Prompt the user with a yes/no question
confirm() {
	local prompt="$1"
	echo "$prompt?"
	read -rp "[y/N]: " answer
	[[ "$answer" =~ ^[Yy] ]]
}
#
# Prompt with a checklist/radiolist
checklist() {
	# Grab the title, checklist type and the options for the checklist.
	local title="$1"
	local type="$2"
	shift 2
	local items=("$@")
	#
	# Give the user their options
	clear >&2
	echo "$title" >&2
	local i=0
	for item in "${items[@]}"; do
		printf "\t$i) $item\n" >&2
		i=$((i + 1))
	done
	#
	# Prompt the user for their answer via the read command
	if [[ "$type" == 'checklist' ]]; then
		cat >&2 <<-'EOF'
			Type your selections in comma-separated format—no spaces.
			(i.e. "1,4,6,9")
		EOF
	elif [[ "$type" == 'radiolist' ]]; then
		cat >&2 <<-'EOF'
			Type your selection (single-answer only)
			(i.e. "5")
		EOF
	else
		cat >&2 <<-EOF
			Incorrect usage of the checklist function;
			($type) was given as the 2nd argument, but the only valid options are (checklist) OR (radiolist).
		EOF
		exit 8
	fi
	read -rp 'Type your selection(s) then press [ENTER] to submit: ' selections >&2
	if [[ -z "$selections" ]]; then
		return 0
	fi
	#
	# Replace commas with spaces
	local selections="${selections//,/ }"
	#
	# Load response into an array
	local selections=($selections)
	#
	# Validate user choices and return the choices
	for choice in "${selections[@]}"; do 
		if [[ "$choice" =~ $numberCheck ]] && (( choice >= 0 && choice <= ${#items[@]} )); then
			echo "${items[$choice]}"
		fi
	done
}
#
# Force-reinstall/install "$@", preffering new configurations over local changes
secure_install() {
	for pkg in "$@"; do
		env DEBIAN_FRONTEND=noninteractive apt-get install --fix-broken -yf --reinstall --no-install-recommends -o Dpkg::Options::=--force-confnew -o Dpkg::Options::=--force-confdef "$pkg"
	done
	dpkg --configure -a ||
		exit 5
}
#
# Pause the execution of the script
pause() {
	cat <<-'EOF'
		⏸️ ⏸️ ⏸️ ===> SCRIPT IS PAUSED <=== ⏸️ ⏸️ ⏸️
		    Press [ENTER] to resume the script.
	EOF
	read -r
	echo '✅: Script was resumed.'
}
# 
# Quick service decomissioning
decommission() {
	(
		set -e
		systemctl disable --now "$1"
		systemctl mask "$1"
	)
}
#
# Quickly apply SystemD override files for services
sysdpatch() {
	local service="${$1%.service}"
	local overrideFile="systemd-overrides/$service.conf"
	local targetDir="/etc/systemd/system/$service.service.d"
	mkdir -p "$targetDir"
	#
	# Apply patch and restart the service
	(
		set -e
		cp "$overrideFile" "$targetDir/override.conf"
		systemctl daemon-reload
		systemctl restart "$service.service"
	)
}
#
# Check for root permissions, if the script is running in a Bash shell and if the system daemon is SystemD
envCheck() {
	if [[ -z "${BASH_SOURCE[0]}" ]]; then
		echo '❌: Script must be ran by Bash intepreter and the script must NOT be sourced'
		exit 1
	elif [[ "$EUID" -ne 0 ]]; then
		cat <<-EOF
			❌: Must run as root. Try (sudo bash $0)
		EOF
		exit 2
	elif [[ "$(cat /proc/1/comm)" != 'systemd' ]]; then
		echo '❌: System is not using SystemD which is the only system daemon supported by this script.'
		exit 3
	elif ! command -v apt apt-get dpkg >/dev/null; then
		echo '❌: This script only works with systems using the APT and DPKG package manager, which this system lacks.'
		exit 4
	elif apt-get update >/dev/null | grep -qEi 'W: Failed to fetch|failed to download'; then
		echo '❌: You lack a proper connection to some APT repositories, ensure you have fully connectivity before running.'
		exit 7
	else
		cat <<-'EOF'
			✅: Script was ran with Bash shell
			✅: Script has root permissions
			✅: System is using the SystemD initialization system
			✅: System has APT and DPKG package manager installed
			✅: System can communicate with APT
		EOF
	fi
}
#
# Function to check for a valid, unused suffix for log files
suffixCheck() {
	local num=1
	while [[ -f "$log_dir/"*"$num" ]]; do
		((num++))
	done
	suffix="$num"
}





#
# Environment Setup
#
# Run the suffix & envCheck
suffixCheck
envCheck
#
# Include hidden directories when globbing
# Trying to avoid errors when globbing results in nothing, and set case insensitivity for responses.
shopt -s dotglob nullglob nocasematch
#
# Remove aliases and disable alias expansion
unalias -a
shopt -u expand_aliases
#
# Make a pipeline's exit code the exit code of the last failed command of the pipelines
set -o pipefail
#
# Log to master a log file
exec > >(tee -a "$log_dir/$(basename "$0")-script-master-log-$suffix")