#!/bin/bash
#
# Helper Logic
#
# Regex to compare against to verify user input is a number
num_chk='^[0-9]+$'
#
# Alternative exit command
alt_exit() {
	if [[
		-z "$*" ||
		0 -lt "$*"
	]]; then
		echo "E: A fatal error occured; exit code: $*"
		exit "$*"
	fi
	#
	# Display success banner
	printf '\e[1m'
	cat <<-'EOF'

		  ---{=========}###[@]###{===========}---
		        WINDOWS AT LOSS AT THE
		          AGAPE FREEDOM OF LINUX
		  ---{=========}###[@]###{===========}---
	EOF
	#
	# Display password hygiene reminder
	printf '\e[0m'
	cat <<-'EOF'

		      Cybersecurity is great; though
		    people often have their priorities
		       mixed up. Make sure you have
		        good password hygiene and
		         a good password manager.
	EOF
	#
	# Enumerate log files to screen
	cat <<-EOF

		Here are the log files from this session:
		$(
			for path in "${log_files[@]}"; do
				printf '%s\n' "$path"
			done
		)
	EOF
}
#
# Alternative clear command
clear() {
	# Print enough newlines to clear the screen & then move the cursor back to the top
	local height
	mapfile -t height <(seq 1 "$(tput lines)")
	printf '\n%.0s' "${height[@]}"
	command clear -x
}
#
# When making a file using the touch command, make the directories its supposed to be in.
touch() {
	# Process each file path
	for path in "$@"; do
		# Make the file's preceeding directories.
		mkdir -p "$(dirname "$path")"
		#
		# Make the file
		printf >> "$path"
	done
}
#
# Prompt the user with a yes/no question
confirm() {
	# Ask the question
	clear
	local answer
	while [[ ! "${answer:0:1}" =~ ^[YyNn]$ ]]; do
		printf "\n$2\n$1? [y/n]: \n"
		read -er answer
		answer="${answer:0:1}"
	done
	#
	# Return exit code based on yes/no
	[[ "$answer" =~ ^[Yy]$ ]]
}
#
# Prompt with a checklist/radiolist
checklist() {
	# Grab the title, checklist type & the options for the checklist.
	local title="$1"
	local type="$2"
	shift 2
	local items=("$@")
	#
	# Give the user their options
	clear >&2
	echo "$title" >&2
	local i=0
	for item in "${items[@]}"; do
		printf "\t$i) $item\n" >&2
		i=$((i + 1))
	done
	#
	# Prompt the user for their answer via the read command
	if [[ "$type" == 'checklist' ]]; then
		cat >&2 <<-'EOF'
			Enter your selections—separated by spaces.
			(i.e. "1 4 6 9")
		EOF
	elif [[ "$type" == 'radiolist' ]]; then
		cat >&2 <<-'EOF'
			Enter a single selection
			(i.e. "5")
		EOF
	else
		cat >&2 <<-EOF
			Incorrect usage of the checklist function;
			($type) was given as the 2nd argument, but the only valid options are (checklist) OR (radiolist).
		EOF
		return 1
	fi
	read -erp 'Type your selection(s) then press [ENTER] to submit: ' -a selections >&2
	#
	# Do nothing with empty responses
	[[ "${#selections[@]}" -eq 0 ]] &&
		return 0
	#
	# Validate user choices & return the choices
	for choice in "${selections[@]}"; do
		[[ "$choice" =~ $num_chk ]] &&
			(( choice < ${#items[@]} )) &&
			echo "${items[$choice]}"
	done
}
#
# Force-reinstall/install "$@", preffering new configurations over local changes
secure_install() {
	env DEBIAN_FRONTEND=noninteractive apt-get install --fix-broken -yf --reinstall --no-install-recommends -o Dpkg::Options::=--force-confnew -o Dpkg::Options::=--force-confdef "$@"
	dpkg --configure -a
}
#
# Pause the execution of the script
pause() {
	read -n1 -p '⏸️ ⏸️ ⏸️ ===> PRESS ANY KEY TO RESUME <=== ⏸️ ⏸️ ⏸️'
	echo 'OK: Script was resumed.'
}
# 
# Quick service decomissioning
decommission() {
	systemctl disable --now "$1"
	systemctl mask "$1"
}
#
# Quickly apply SystemD override files for services
svc_patch() {
	(
		# Apply patch & restart the service
		set -e
		local service_file="/etc/systemd/system/$1.service.d/override.conf"
		touch "$service_file"
		install -m 600 -o root -g root "systemd-overrides/$1.conf" "$service_file"
		systemctl daemon-reload
		systemctl restart "$1.service"
	)
}
#
# Check for root permissions, if the script is running in a Bash shell & if the system daemon is SystemD
environ_chk() {
	# Alert the user of the checks to avoid an invisible hang
	echo 'Running environment checks...'
	#
	# Initialize a variable which when set will stop the script at the end of the check
	local exit
	#
	# Start the check
	# 1. Is this running in Bash; & am I sourced?
	# 2. Am I running as root?
	# 3. Is this system using SystemD?
	# 4. Can I connect to the APT repositories?
	if [[ -z "${BASH_SOURCE[0]}" ]]; then
		echo 'E: Script must be ran by Bash intepreter & must NOT be sourced.'
		exit=1
	elif [[ "$EUID" -ne 0 ]]; then
		echo "E: Must run as root. Try (sudo bash $0)"
		exit=1
	elif [[ "$(cat /proc/1/comm)" != 'systemd' ]]; then
		echo 'E: System is not using SystemD which is the only system daemon supported by this script.'
		exit=1
	elif ! command -v apt apt-get dpkg &>/dev/null; then
		echo 'E: This script requires the APT package manager, which this system lacks.'
		exit=1
	elif timeout 10 apt-get update |
		grep -Ei '(failed to fetch|failed to download)';
	then
		echo 'E: You lack a sufficient connection to some APT repositories.'
		exit=1
	fi
	#
	# If the exit variable is set, exit.
	[[ -n "$exit" ]] &&
		exit 1
}





#
# Environment Setup
#
# Secure path variable
declare -rx PATH='/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin'
#
# Secure UMASK
umask 077
#
# Check for an open logfile name
i=1
while compgen -G "*-$i.log" >/dev/null; do
	(( i++ ))
done
#
# Log to master a log file
exec > >(tee -a "$(basename "$0")-master-$i.log")
#
# Check for a supported environment
environ_chk
#
# Fetch log files from current script session
mapfile -t log_files < <(timeout 5 find . -maxdepth 1 -type f -name "*$i.log")
[[ -z "${log_files[*]}" ]] &&
	log_files=('E: Failed to fetch log files.')
#
# Include hidden directories when globbing
# Trying to avoid errors when globbing results in nothing, & set case insensitivity for responses.
shopt -s dotglob nullglob nocasematch
#
# Unset aliases & disable alias expansion
unalias -a
shopt -u expand_aliases
#
# Make a pipeline's exit code the exit code of the last failed command of the pipelines
set -o pipefail