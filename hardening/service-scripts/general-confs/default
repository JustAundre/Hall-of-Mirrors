server {
	listen 80 default_server;
	listen [::]:80 default_server;

	root /var/www/html;
	index index.html index.htm;

	server_name _;

	# Enable security headers
	include snippets/security-headers.conf;

	# Disable diectory enumeration
	autoindex off;

	# Whitelist only common HTTP methods
	if ($request_method !~ ^(GET|HEAD|POST)$ ) {
		return 405;
	}

	# Hide dot files
	location ~ /\. {
		deny all;
		access_log off;
		log_not_found off;
	}

	location / {
		try_files $uri $uri/ =404;
	}
}